diff --git a/src/hooks.h b/src/hooks.h
new file mode 100644
index 0000000..3f89355
--- /dev/null
+++ b/src/hooks.h
@@ -0,0 +1,42 @@
+#pragma once
+// hooks.h: optional progress hooks and thread override (yue2-android patch v2: preview, refine)
+//
+// Inline globals, one instance per process across every translation unit.
+// All hooks are optional; a null pointer keeps upstream behaviour.
+
+#include <cmath>
+#include <vector>
+
+struct Yue2Hooks {
+    // every AR decode step and once more with step = -1 when the stage ends;
+    // phase 0 = score (BPE ids), 1 = semantic (codec ids with the offset)
+    void (*ar_step)(void * user, int phase, int step, int max_tokens, const std::vector<int> * tokens) = nullptr;
+    // after every flow matching step of a chunk
+    void (*nar_step)(void * user, int step, int steps) = nullptr;
+    // after every VAE tile
+    void (*vae_tile)(void * user, int tile, int tiles) = nullptr;
+    void * user = nullptr;
+    // once, after flow matching step preview_step of a one-variation solve: the clean latents
+    // guessed from that state (x0 = x_t - t * v), [frames, latent_dim]
+    void (*nar_preview)(void * user, const float * latents, int frames) = nullptr;
+    int preview_step = 0;
+    // refine: the song's noise is replaced by these latents pulled back to refine_t on the
+    // straight path from it, and only the rest of the step schedule runs
+    const float * refine_latents = nullptr;
+    int           refine_frames  = 0;
+    float         refine_t       = 1.0f;
+};
+
+inline Yue2Hooks g_yue2_hooks;
+
+// Steps a solve of an n-step schedule runs: all of them, or the tail of a refine
+inline int yue2_solve_steps(int steps) {
+    if (!g_yue2_hooks.refine_latents) {
+        return steps;
+    }
+    int n = (int) lroundf(g_yue2_hooks.refine_t * (float) steps);
+    return n < 1 ? 1 : (n > steps ? steps : n);
+}
+
+// CPU thread count, 0 = upstream heuristic
+inline int g_yue2_n_threads = 0;
