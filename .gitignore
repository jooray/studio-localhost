**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/


# Localhost Recording Studio
/dist/
__pycache__/
.venv/
**/.venv/
*.egg-info/
# local, machine-specific configuration (never committed)
/local/
*.local.json
.env
